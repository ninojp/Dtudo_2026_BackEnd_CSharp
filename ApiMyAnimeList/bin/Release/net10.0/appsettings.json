{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Extensions.Http": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:O} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Seq": {
    "Url": "http://localhost:5341"
  },
  "ServiceAuthentication": {
    "Enabled": false,
    "Clients": []
  },
  "AllowedHosts": "*",
  "MyAnimeList": {
    "BaseUrl": "https://api.myanimelist.net/v2/",
    "AllowedHosts": [
      "api.myanimelist.net"
    ],
    "AllowedPathPrefix": "/v2/",
    "TimeoutSeconds": 20,
    "MaxRetries": 3,
    "RetryDelayMilliseconds": 250,
    "CacheMinutes": 15,
    "TotalTimeoutSeconds": 90,
    "CircuitBreakerFailureRatio": 0.5,
    "CircuitBreakerMinimumThroughput": 5,
    "CircuitBreakerSamplingSeconds": 30,
    "CircuitBreakerBreakSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5178"
    ]
  }
}
