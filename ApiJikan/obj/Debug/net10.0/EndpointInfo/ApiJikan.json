{
  "openapi": "3.0.4",
  "info": {
    "title": "Api Jikan - Consulta Externa",
    "description": "Esta é uma Api de consulta à API externa Jikan (MyAnimeList). Fornece endpoints para buscar informações detalhadas sobre animes.",
    "version": "v1"
  },
  "paths": {
    "/ApiJikan/search": {
      "get": {
        "tags": [
          "ApiJikan"
        ],
        "summary": "End-Point da minha Api Local que faz uma busca na Api externa Jikan, por nome do anime.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Termo de busca",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Número da página (padrão: 1)",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/BuscarAnimePorNomeResponseDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuscarAnimePorNomeResponseDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuscarAnimePorNomeResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          },
          "504": {
            "description": "Gateway Timeout"
          }
        }
      }
    },
    "/ApiJikan/{id}": {
      "get": {
        "tags": [
          "ApiJikan"
        ],
        "summary": "Busca um anime específico por ID do MyAnimeList",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID do anime no MyAnimeList",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/BuscarAnimePorIdResponseDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuscarAnimePorIdResponseDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuscarAnimePorIdResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/ApiJikan/{id}/relations": {
      "get": {
        "tags": [
          "ApiJikan"
        ],
        "summary": "Busca os animes relacionados a um anime específico pelo ID do MyAnimeList.\r\nUtiliza o endpoint dedicado /anime/{id}/relations da Jikan e retorna as imagens hidratadas de cada entrada.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID do anime no MyAnimeList",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AnimeRelationGroupDto"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AnimeRelationGroupDto"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AnimeRelationGroupDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnimeBuscaResumoDto": {
        "type": "object",
        "properties": {
          "malId": {
            "type": "integer",
            "format": "int32"
          },
          "url": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "titleEnglish": {
            "type": "string",
            "nullable": true
          },
          "titleJapanese": {
            "type": "string",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "type": "string",
            "nullable": true
          },
          "episodes": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "score": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "year": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Resumo público de anime retornado na listagem de busca."
      },
      "AnimeImageVariantDto": {
        "type": "object",
        "properties": {
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "smallImageUrl": {
            "type": "string",
            "nullable": true
          },
          "largeImageUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Variante pública de imagem do anime."
      },
      "AnimeImagesDto": {
        "type": "object",
        "properties": {
          "jpg": {
            "$ref": "#/components/schemas/AnimeImageVariantDto"
          }
        },
        "additionalProperties": false,
        "description": "Coleção pública de imagens do anime."
      },
      "AnimeRelationEntryDto": {
        "type": "object",
        "properties": {
          "malId": {
            "type": "integer",
            "format": "int32"
          },
          "type": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "url": {
            "type": "string",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Entrada pública de anime relacionado."
      },
      "AnimeRelationGroupDto": {
        "type": "object",
        "properties": {
          "relation": {
            "type": "string",
            "nullable": true
          },
          "entry": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnimeRelationEntryDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Grupo público de relações de um anime."
      },
      "BuscarAnimePorIdResponseDto": {
