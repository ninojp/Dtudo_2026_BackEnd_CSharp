        },
        "additionalProperties": false,
        "description": "Resposta pública do endpoint de detalhes de anime por ID."
      },
      "BuscarAnimePorNomeResponseDto": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnimeBuscaResumoDto"
            },
            "nullable": true
          },
          "currentPage": {
            "type": "integer",
            "format": "int32"
          },
          "totalPages": {
