{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Extensions.Http": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:O} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Seq": {
    "Url": ""
  },
  "Authentication": {
    "Issuer": "https://localhost:7243/",
    "Audience": "urn:dtudo:api-discogs"
  },
  "ApiDiscogs": {
    "BaseUrl": "https://api.discogs.com/",
    "AllowedHosts": [
      "api.discogs.com"
    ],
    "AllowedPathPrefix": "/",
    "UserAgent": "Dtudo-ApiDiscogs/1.0",
    "TimeoutSeconds": 20,
    "MaxRetries": 3,
    "RetryDelayMilliseconds": 250,
    "CacheMinutes": 15,
    "MaxResponseBytes": 2000000,
    "TotalTimeoutSeconds": 90,
    "CircuitBreakerFailureRatio": 0.5,
    "CircuitBreakerMinimumThroughput": 5,
    "CircuitBreakerSamplingSeconds": 30,
    "CircuitBreakerBreakSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5178"
    ]
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
