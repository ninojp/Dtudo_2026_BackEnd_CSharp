{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:O} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Seq": {
    "Url": "http://localhost:5341"
  },
  "Authentication": {
    "Issuer": "https://localhost:7243",
    "Audience": "urn:dtudo:api-file-storage"
  },
  "FileStorage": {
    "Roots": [],
    "ExportRootId": "media",
    "ExportPathPrefix": "my-animes",
    "Limits": {
      "MaxFileSizeBytes": 52428800,
      "MaxFileNameLength": 255,
      "MinimumFreeSpaceBytes": 104857600,
      "MaxIdempotencyKeyLength": 128,
      "ScannerTimeoutSeconds": 60,
      "MaxBulkDeleteItems": 100,
      "DeletePreviewLifetimeSeconds": 120
    },
    "AllowedFileTypes": [
      {
        "Extension": ".jpg",
        "MimeType": "image/jpeg",
        "MagicBytesHex": "FF D8 FF"
      },
      {
        "Extension": ".jpeg",
        "MimeType": "image/jpeg",
        "MagicBytesHex": "FF D8 FF"
      },
      {
        "Extension": ".png",
        "MimeType": "image/png",
        "MagicBytesHex": "89 50 4E 47 0D 0A 1A 0A"
      },
      {
        "Extension": ".gif",
        "MimeType": "image/gif",
        "MagicBytesHex": "47 49 46 38"
      }
    ],
    "Scanner": {
      "RequireDefender": true,
      "RequireAmsi": true
    },
    "StepUp": {
      "IdentityBaseUrl": "https://localhost:7243",
      "Action": "filesystem.command",
      "TimeoutSeconds": 10
    }
  },
  "AllowedHosts": "*"
}
