{
  "ApiMyAnimes": {
    "BaseUrl": "https://localhost:63980"
  },
  "ApiMyAnimeList": {
    "BaseUrl": "https://localhost:7146",
    "AutoStartUrl": "https://localhost:7146"
  },
  "ApiIdentity": {
    "BaseUrl": "https://localhost:7243"
  },
  "ApiFileStorage": {
    "BaseUrl": "https://localhost:7244"
  },
  "Identity": {
    "ClientId": "dtudo-winapp",
    "RedirectUri": "http://127.0.0.1:49173/callback/",
    "Scopes": [
      "openid",
      "profile",
      "offline_access",
      "identity.login",
      "identity.provision",
      "catalog.read",
      "catalog.write",
      "catalog.delete",
      "filesystem.command",
      "health.read"
    ],
    "Resources": [
      "urn:dtudo:api-my-animes",
      "urn:dtudo:api-my-animelist",
      "urn:dtudo:api-file-storage"
    ],
    "AuthenticationTimeoutSeconds": 300
  },
  "DtudoSite": {
    "StartUrl": "http://localhost:5173/animes",
    "StartupTimeoutSeconds": 90
  },
  "Monitoring": {
    "HealthProbeTimeoutSeconds": 5
  },
  "Http": {
    "AllowInvalidCertificates": true
  }
}
