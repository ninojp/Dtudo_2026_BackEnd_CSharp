{
  "IdentityDatabase": {
    "DatabaseName": "DtudoIdentity.Development"
  },
  "OpenIddict": {
    "Issuer": "https://localhost:7243/",
    "WinApp": {
      "ClientId": "dtudo-winapp",
      "RedirectUri": "http://127.0.0.1:49173/callback/",
      "Scopes": [
        "openid",
        "profile",
        "offline_access",
        "identity.login",
        "identity.provision",
        "catalog.write",
        "catalog.delete",
        "filesystem.command"
      ]
    }
  },
  "IdentitySessions": {
    "LifetimeDays": 30,
    "AccessTokenLifetimeSeconds": 300,
    "RefreshTokenLifetimeDays": 30,
    "TokenEntropyBytes": 32
  },
  "ServiceAuthentication": {
    "Enabled": false,
    "AccessTokenLifetimeSeconds": 300,
    "Clients": []
  },
  "AllowedHosts": "localhost"
}
